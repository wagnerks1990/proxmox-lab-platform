[Unit]
Description=Proxmox Lab Platform Update Agent
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
Group=proxmox-lab-updater
EnvironmentFile=/opt/proxmox-lab-platform/app/.env
Environment=PLATFORM_APP_DIR=/opt/proxmox-lab-platform/app
Environment=PLATFORM_STATE_DIR=/var/lib/proxmox-lab-platform
ExecStart=/usr/bin/python3 /usr/local/lib/proxmox-lab-updater.py
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# The agent atomically stages replacements next to these files (.new), so
# systemd must permit writes to their parent directories, not just the files.
ReadWritePaths=/opt/proxmox-lab-platform /var/lib/proxmox-lab-platform /run/proxmox-lab-updater /var/run/docker.sock /usr/local/lib /etc/systemd/system

[Install]
WantedBy=multi-user.target
