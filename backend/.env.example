DATABASE_URL=postgresql+psycopg://postgres:replace_me@localhost:5432/labgoblin
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
BOOTSTRAP_ADMIN_TOKEN=replace-with-a-one-time-random-secret
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=
PROXMOX_BASE_URL=https://proxmox.example.edu:8006/api2/json
PROXMOX_TOKEN_ID=lab@pve!api
PROXMOX_TOKEN_SECRET=replace_me
PROXMOX_VERIFY_SSL=true
CONFIG_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
LAB_VM_SSH_KNOWN_HOSTS=/run/secrets/lab_vm_known_hosts
LAB_VM_SSH_PRIVATE_KEY_PATH=/run/secrets/lab_vm_ssh_key
RATE_LIMIT_PER_MINUTE=60
GUACAMOLE_INTERNAL_URL=http://guacamole:8080/guacamole
GUACAMOLE_BASE_URL=/guacamole
GUACAMOLE_ADMIN_USER=replace_me
GUACAMOLE_ADMIN_PASSWORD=replace_me
GUACAMOLE_DATASOURCE=postgresql
GUACAMOLE_VERIFY_SSL=true
UPDATER_TOKEN=replace-with-a-separate-long-random-secret
UPDATER_REPOSITORY=https://github.com/wagnerks1990/labgoblin.git
UPDATER_GID=replace-with-host-updater-group-id
UPDATER_ALLOW_AUTOMATIC=false
UPDATER_REQUIRE_SIGNED_COMMITS=false
UPDATER_SOCKET_PATH=/var/lib/labgoblin/updater/updater.sock
REDIS_URL=redis://localhost:6379/0
REPLAY_STORE_BACKEND=redis
WORKER_LOCK_BACKEND=redis
