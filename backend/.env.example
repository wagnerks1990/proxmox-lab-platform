DATABASE_URL=postgresql+psycopg://postgres:replace_me@localhost:5432/proxmox_lab
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
PROXMOX_BASE_URL=https://proxmox.example.edu:8006/api2/json
PROXMOX_TOKEN_ID=lab@pve!api
PROXMOX_TOKEN_SECRET=replace_me
PROXMOX_VERIFY_SSL=true
CONFIG_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
RATE_LIMIT_PER_MINUTE=60
GUACAMOLE_INTERNAL_URL=http://guacamole:8080/guacamole
GUACAMOLE_BASE_URL=/guacamole
GUACAMOLE_ADMIN_USER=replace_me
GUACAMOLE_ADMIN_PASSWORD=replace_me
GUACAMOLE_DATASOURCE=postgresql
GUACAMOLE_VERIFY_SSL=true
UPDATER_TOKEN=replace-with-a-separate-long-random-secret
UPDATER_REPOSITORY=https://github.com/wagnerks1990/proxmox-lab-platform.git
UPDATER_GID=replace-with-host-updater-group-id
